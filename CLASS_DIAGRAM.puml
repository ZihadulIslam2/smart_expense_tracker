@startuml SmartExpenseTracker_ClassDiagram
!theme plain
title Smart Expense Tracker - Class Diagram

' ===== COLOR THEME =====
skinparam backgroundColor white
skinparam defaultFontColor #1a1a1a
skinparam defaultBackgroundColor #e8f4f8
skinparam defaultBorderColor #2196F3
skinparam classBackgroundColor #e8f4f8
skinparam classBorderColor #2196F3
skinparam classFontColor #1a1a1a
skinparam packageBackgroundColor #f0f7ff
skinparam packageBorderColor #1976D2
skinparam packageFontColor #1a1a1a
skinparam noteBackgroundColor #fffde7
skinparam noteBorderColor #FF9800
skinparam noteFontColor #1a1a1a
skinparam arrowColor #2196F3
skinparam classHeaderBackgroundColor #2196F3
skinparam classHeaderFontColor white

' ===== MODELS =====
package "Models" {
  class TransactionModel {
    - id: String
    - userId: String
    - title: String
    - amount: double
    - type: String (income/expense)
    - category: String
    - date: DateTime
    - description: String?
    - accountId: String?
    ---
    + fromMap(Map): TransactionModel
    + toMap(): Map
    + copyWith(): TransactionModel
  }

  class AccountModel {
    - id: String
    - userId: String
    - name: String
    - type: String (cash/bank/mobile_wallet)
    - initialBalance: double
    - currency: String
    - isActive: bool
    - createdAt: DateTime
    - updatedAt: DateTime
    ---
    + fromDocument(Map): AccountModel
    + toMap(): Map
    + copyWith(): AccountModel
  }

  class BudgetModel {
    - id: String
    - userId: String
    - category: String
    - amount: double
    - month: int
    - year: int
    - createdAt: DateTime
    - updatedAt: DateTime
    ---
    + fromDocument(Map): BudgetModel
    + toMap(): Map
    + copyWith(): BudgetModel
  }

  class GoalModel {
    - id: String
    - userId: String
    - title: String
    - description: String
    - targetAmount: double
    - currentAmount: double
    - targetDate: DateTime
    - category: String
    - iconName: String?
    - createdAt: DateTime
    - updatedAt: DateTime
    ---
    + progressPercentage: double
    + remainingAmount: double
    + fromDocument(Map): GoalModel
    + toMap(): Map
    + copyWith(): GoalModel
  }
}

' ===== CORE SERVICES =====
package "Core Services" {
  class AppwriteClient {
    - {static} client: Client
    ---
    + {static} init(): void
    + {static} checkServerHealth(): Future<void>
    + {static} checkCurrentUser(): Future<void>
  }

  class DataCacheService {
    - prefs: SharedPreferences
    - _cacheDuration: Duration
    ---
    + cacheData<T>(key, data): Future<void>
    + getCachedData<T>(key, fromJson): Future<T?>
    + clearCache(key): Future<void>
    + clearAllCache(): Future<void>
    + isCacheValid(key): bool
    + getCacheAgeSeconds(key): int?
  }

  class NotificationService {
    - {static} _instance: NotificationService
    - _notifications: FlutterLocalNotificationsPlugin
    - _initialized: bool
    ---
    + {static} getInstance(): NotificationService
    + initialize(): Future<void>
    + requestPermissions(): Future<bool>
    + showNotification(...): Future<void>
    + scheduleNotification(...): Future<void>
    + cancelNotification(id): Future<void>
  }

  class BadgeService {
    - {static} _instance: BadgeService
    - budgetWarnings: List<String>
    - aiTipNotification: String?
    ---
    + {static} getInstance(): BadgeService
    + addBudgetWarning(warning): void
    + clearBudgetWarnings(): void
    + setAITipNotification(tip): void
    + notifyListeners(): void
  }
}

' ===== AUTH SERVICE =====
package "Auth Service" {
  class AuthService {
    - account: Account
    ---
    + register(name, email, password): Future<void>
    + login(email, password): Future<void>
    + logout(): Future<void>
    + getCurrentUser(): Future<User?>
    + updateProfile(name): Future<void>
  }
}

' ===== FEATURE SERVICES =====
package "Feature Services" {
  class ExpenseService {
    - _databases: Databases
    - _databaseId: String
    - _collectionId: String
    - _cacheService: DataCacheService
    ---
    + addTransaction(...): Future<TransactionModel>
    + getUserTransactions(...): Future<List<TransactionModel>>
    + updateTransaction(...): Future<TransactionModel>
    + deleteTransaction(id): Future<void>
    + getTransactionsByCategory(...): Future<List<TransactionModel>>
  }

  class BudgetService {
    - _databases: Databases
    - _databaseId: String
    - _collectionId: String
    ---
    + createBudget(...): Future<BudgetModel>
    + getUserBudgets(userId): Future<List<BudgetModel>>
    + updateBudget(...): Future<BudgetModel>
    + deleteBudget(id): Future<void>
    + checkBudgetOverrun(...): bool
  }

  class AccountService {
    - _databases: Databases
    - _databaseId: String
    - _collectionId: String
    ---
    + createAccount(...): Future<AccountModel>
    + getAccounts(userId): Future<List<AccountModel>>
    + updateAccount(...): Future<AccountModel>
    + deleteAccount(id): Future<void>
    + getTotalBalance(userId): Future<double>
  }

  class AnalyticsService {
    - _expenseService: ExpenseService
    - _budgetService: BudgetService
    ---
    + calculateTotalIncome(...): Future<double>
    + calculateTotalExpense(...): Future<double>
    + getCategorySpending(...): Future<Map<String, double>>
    + getMonthlyTrend(...): Future<List<Map>>
    + getBudgetStatus(...): Future<Map<String, double>>
    + getSavingsRate(...): Future<double>
  }

  class GoalService {
    - _databases: Databases
    - _databaseId: String
    - _collectionId: String
    ---
    + createGoal(...): Future<GoalModel>
    + getUserGoals(userId): Future<List<GoalModel>>
    + updateGoal(...): Future<GoalModel>
    + deleteGoal(id): Future<void>
    + updateGoalProgress(...): Future<void>
  }
}

' ===== AI SERVICE =====
package "AI Services" {
  class AIService {
    - _model: GenerativeModel
    - _apiKey: String
    - _cacheService: DataCacheService?
    ---
    + getFinancialAnalysis(...): Future<Map>
    + getSpendingAdvice(...): Future<String>
    + getSavingTips(...): Future<String>
    + getFinancialWarnings(...): Future<List<String>>
    + getSavingsGoalsAdvice(...): Future<String>
    - _initializeModel(): void
    - _getComprehensiveAnalysis(...): Future<Map>
  }

  class PreloadService {
    - {static} _instance: PreloadService
    - _isPreloading: bool
    - _isPreloaded: bool
    ---
    + {static} getInstance(): PreloadService
    + preloadAIAnalysis(...): Future<void>
    + isPreloaded: bool
    + cancelPreload(): void
  }
}

' ===== THEME =====
package "Theme" {
  class AppTheme {
    - {static} primaryColor: Color
    - {static} primaryDark: Color
    - {static} accentColor: Color
    - {static} errorColor: Color
    - {static} warningColor: Color
    ---
    + {static} lightTheme(): ThemeData
    + {static} darkTheme(): ThemeData
    + {static} getCategoryColor(category): Color
  }
}

' ===== MAIN APP =====
package "Main Application" {
  class MyApp {
    + build(): Widget
  }
}

' ===== RELATIONSHIPS =====

' Models are used by services
ExpenseService --> TransactionModel : uses
BudgetService --> BudgetModel : uses
AccountService --> AccountModel : uses
GoalService --> GoalModel : uses

' Services depend on core services
ExpenseService --> DataCacheService : uses
AnalyticsService --> ExpenseService : uses
AnalyticsService --> BudgetService : uses
PreloadService --> AIService : uses
PreloadService --> ExpenseService : uses
PreloadService --> BudgetService : uses
PreloadService --> AnalyticsService : uses
PreloadService --> GoalService : uses

' AI Service depends on caching
AIService --> DataCacheService : uses

' Core services use AppwriteClient
AppwriteClient --> "*" Client : initializes

' BadgeService is used for notifications
NotificationService --> BadgeService : notifies

' AuthService uses AppwriteClient
AuthService --> AppwriteClient : uses

' Main app uses theme
MyApp --> AppTheme : uses

' MyApp orchestrates Auth and other services
MyApp --> AuthService : uses
MyApp --> NotificationService : uses

note right of AppwriteClient
  Singleton pattern
  Manages Appwrite Client instance
  Handles server health checks
end note

note right of DataCacheService
  Caches data with 1-hour TTL
  Uses SharedPreferences
  Supports generic type caching
